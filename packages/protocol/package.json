{
  "name": "@personaxis/protocol",
  "version": "0.17.0",
  "description": "The boundary between a Personaxis front-end and the engine: typed operations and events over JSON-RPC 2.0 on Unix sockets and Windows named pipes, plus the Agent Client Protocol bridge in both directions.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@personaxis/core": "workspace:*",
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personaxis/personaxis.git",
    "directory": "packages/protocol"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    }
  }
}
