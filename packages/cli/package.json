{
  "name": "personaxis",
  "version": "0.17.0",
  "description": "Define an AI persona once in versionable files and run it as a working agent whose limits are enforced outside the model: values clamped to declared envelopes, tool calls gated, every change in a hash-chained record. The personaxis.md spec v1.1 toolchain: create, validate, lint, compile, the interactive app, guard, and more.",
  "keywords": [
    "ai",
    "agents",
    "persona",
    "persona-spec",
    "agent-personhood",
    "spec",
    "cli"
  ],
  "homepage": "https://personaxis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personaxis/personaxis.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./linter": "./dist/linter/index.js"
  },
  "bin": {
    "personaxis": "dist/index.js",
    "personaxis-scan": "dist/scan-bin.js",
    "personaxis-hook": "dist/hook-bin.js",
    "personaxis-acp": "dist/acp-bin.js"
  },
  "files": [
    "dist",
    "templates",
    "hosts"
  ],
  "scripts": {
    "build": "node ../../scripts/embed-assets.mjs && tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "node ../../scripts/embed-assets.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@personaxis/core": "workspace:*",
    "@personaxis/protocol": "workspace:*",
    "@personaxis/sdk": "workspace:*",
    "@personaxis/spec": "workspace:*",
    "@personaxis/tui": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^12.5.2",
    "js-yaml": "^4.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "fast-check": "^4.8.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
