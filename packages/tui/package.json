{
  "name": "@personaxis/tui",
  "version": "0.17.1",
  "description": "Terminal UI for Personaxis: the Ink components the personaxis app is built from, and personaxis-dash, a live dashboard of a persona's sigil, envelopes and memory-chain integrity.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./visual": "./dist/visual.js",
    "./screen": "./dist/screen.js",
    "./ink": "./dist/ink.js",
    "./prompt": "./dist/prompt.js",
    "./viewport": "./dist/viewport.js",
    "./fullscreen": "./dist/fullscreen.js",
    "./ui": "./dist/ui.js"
  },
  "bin": {
    "personaxis-dash": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@personaxis/core": "workspace:*",
    "@personaxis/protocol": "workspace:*",
    "chalk": "^5.4.1",
    "diff": "^8.0.3",
    "ink": "^7.1.0",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.0",
    "marked-terminal": "^7.3.0",
    "react": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personaxis/personaxis.git",
    "directory": "packages/tui"
  }
}
