{
  "name": "@personaxis/tui",
  "version": "0.15.0",
  "description": "Personaxis TUI, Ink 7 components (living dashboard, streaming transcript with commit queue, brand sigil/aura) + the pre-Ink REPL line editor (until F3.6).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./visual": "./dist/visual.js",
    "./screen": "./dist/screen.js",
    "./ink": "./dist/ink.js",
    "./prompt": "./dist/prompt.js",
    "./viewport": "./dist/viewport.js",
    "./fullscreen": "./dist/fullscreen.js",
    "./ui": "./dist/ui.js"
  },
  "bin": {
