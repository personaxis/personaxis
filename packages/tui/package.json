    "test": "vitest run"
  },
  "dependencies": {
    "@personaxis/core": "workspace:*",
    "chalk": "^6.0.0",
    "@personaxis/protocol": "workspace:*",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "marked": "^18.0.9",
    "marked-terminal": "^7.3.0",
    "ink-text-input": "^6.0.0",
    "zustand": "^5.0.15",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0",
    "@types/react": "^19.2.18",
    "@types/diff": "^7.0.0",
    "ink-testing-library": "^4.0.0"
  },
  "publishConfig": {
