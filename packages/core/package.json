{
  "name": "@personaxis/core",
  "version": "0.17.1",
  "description": "The Personaxis engine: state clamped to declared envelopes, the governed living loop and agent loop, the gate on every tool call, hash-chained record, memory, injection scanning and compilation. Framework-agnostic, no UI.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/gen-version.mjs && tsc",
    "lint": "node ./scripts/gen-version.mjs && tsc --noEmit",
    "test": "node ./scripts/gen-version.mjs && vitest run",
    "test:coverage": "node ./scripts/gen-version.mjs && vitest run --coverage"
  },
  "dependencies": {
    "@personaxis/spec": "workspace:*",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "5.0.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/personaxis/personaxis.git",
    "directory": "packages/core"
  }
}
