{
  "name": "main: checks must pass",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~DEFAULT_BRANCH"],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          { "context": "test suite (ubuntu / node 22)" },
          { "context": "golden test (validate CMO = PASS)" },
          { "context": "governance evals (deterministic, no API keys)" },
          { "context": "build & typecheck (ubuntu-latest / node 22)" }
        ]
      }
    }
  ]
}
