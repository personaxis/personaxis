{
	"name": "personaxis-monorepo",
	"version": "0.0.0",
	"private": true,
	"description": "Personaxis monorepo: build a persona, the whole way a professional works, and load it into your coding agent. Packages: personaxis (cli), @personaxis/{core,spec,mcp,sdk,protocol,evals,tui}.",
	"homepage": "https://personaxis.com",
	"repository": {
		"type": "git",
		"url": "https://github.com/personaxis/personaxis"
	},
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=20.18.1"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"lint": "pnpm -r run lint",
		"test": "pnpm -r run test",
		"test:coverage": "pnpm -r run test:coverage",
		"coverage:subprocess": "node scripts/coverage-subprocess.mjs",
		"package": "node scripts/package.mjs",
		"sync-mirror": "node scripts/sync-spec-mirror.mjs",
		"check-mirror": "node scripts/sync-spec-mirror.mjs --check",
		"check-private": "node scripts/check-private.mjs",
		"check-private-history": "node scripts/check-private-history.mjs origin/main",
		"check-docs-refs": "node scripts/check-docs-refs.mjs",
		"check-docs-style": "node scripts/check-docs-style.mjs",
		"check-test-types": "node scripts/check-test-types.mjs",
		"cli": "node packages/cli/dist/index.js"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"react-devtools-core": "^7.0.1",
		"typescript": "^5.8.3"
	}
}
