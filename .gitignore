node_modules/
dist/
dist-bin/
*.js.map

# generated (codegen at build time from schema/ + templates/ + package.json)
packages/cli/src/generated/
packages/core/src/generated/
packages/spec/src/generated/

# Test artifacts from local CLI runs
.claude/
.codex/
.agents/
.cursor/
# The manifest `npx skills add` writes. It lives at the root beside the folders above and is
# the same kind of thing: a developer's tooling, not part of the engine that is published.
skills-lock.json
# Anchored to the root as `.personaxis/*`, which does not cover a package. A test
# whose path resolves from the working directory writes into whichever one it ran
# from, and one did: `packages/cli/.personaxis/mcp-approvals.json` reached a commit.
**/.personaxis/*
!.personaxis/personaxis.md
# Sub-personas stay local: the benchmark's persona lives here but is not a public example.
.recompile-pending.json
# F3.2, ephemeral derived compiler output (hot/cold consumer slices)
**/.dist/

# Detailed SaaS build plan, intentionally NOT committed (fed to the SaaS repo session)
SAAS_BUILD_PLAN.md
# Fable 5 open brief, internal only
FABLE5_BRIEF.md
# Internal working docs and research bundle, kept local (never public)
plan/
research/
product/
# Security architecture docs, kept local for now (published later)
docs/security/
# Stray sandbox-test artifacts
/SOUL.md
/.hermes/
/time.md

# Coverage reports (the floor lives in vitest.floor.ts, the output does not)
coverage/

# Session presence files. The engine writes these BESIDE a persona, so anything that
# runs the server against a path inside the repo leaves them here. They are runtime
# state of one process, never source.
presence/

# Python bytecode (the Hermes plugin is tested with a real interpreter)
__pycache__/
*.pyc
